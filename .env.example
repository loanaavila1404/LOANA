# ==============================================================
# Variables de Entorno - Centro de Capacitaciones Brusben
# ==============================================================

# Supabase (Obligatorias en Vercel y Entorno Local)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Compatibilidad alternativa (si usas la convención nueva de publishable key)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Permisos elevados del servidor (opcional / no exponer en cliente)
# SUPABASE_SECRET_KEY=sb_secret_...

# Flags operacionales
NEXT_PUBLIC_SEDES_ENABLED=false
